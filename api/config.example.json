{
  "listen_host": "0.0.0.0",
  "listen_port": 8080,

  "website_dir": "../website",
  "data_dir": "./data",

  "dry_run": false,

  "site_secret": "REPLACE_WITH_GENERATED_VALUE",
  "admin_key": "REPLACE_WITH_ADMIN_KEY",
  "rate_limit": { "per_ip_per_hour": 10 },

  "request": {
    "max_stack_groups": 6
  },

  "proxmox": {
    "host": "https://127.0.0.1:8006",
    "verify_tls": false,
    "api_token_id": "agenc-bot@pve!agenc",
    "api_token_secret": "REPLACE_FROM_/root/.agenc-token",
    "node": "pve",
    "template_storage": "local",
    "rootfs_storage": "ssd120",
    "os_template": "ubuntu-24.04"
  },

  "container": {
    "vmid_start": 1000,
    "vmid_end": 1999,
    "swap_mb": 512,
    "cpulimit": null,
    "unprivileged": true,
    "net_bridge": "sandbox",
    "net_preflight": true,
    "disk_preflight": true,
    "disk_headroom_pct": 10,
    "ip": "dhcp",
    "features": "nesting=1",
    "ostype": "ubuntu",
    "start": true,
    "agency_ssh_key": "",
    "ssh_port": 22,
    "poll_interval_s": 5,
    "create_timeout_s": 600,
    "stack_timeout_s": 900
  },

  "plans": {
    "micro":    { "memory_mb": 1024, "disk_gb": 30, "cores": 1, "cpuunits": 256,  "price_usd_per_month": 8.0  },
    "nano":     { "memory_mb": 4096, "disk_gb": 50, "cores": 4, "cpuunits": 1024, "price_usd_per_month": 16.0 },
    "standard": { "memory_mb": 8192, "disk_gb": 64, "cores": 8, "cpuunits": 2048, "price_usd_per_month": 32.0 }
  },

  "billing": {
    "trial_days": 30,
    "default_period": "monthly",
    "default_plan": "standard",
    "warn_before_s": 86400,
    "periods": {
      "weekly":      { "days": 7,  "months": 0.25 },
      "fortnightly": { "days": 14, "months": 0.5 },
      "monthly":     { "days": 30, "months": 1.0 }
    },
    "accepted_assets": ["USDC", "USDT"],
    "chains": {
      "USDC": { "chain": "ethereum", "network": "ERC-20" },
      "USDT": { "chain": "ethereum", "network": "ERC-20" }
    },
    "receive_addresses": {
      "USDC": "0x0000000000000000000000000000000000000000",
      "USDT": "0x0000000000000000000000000000000000000000"
    },
    "quote_valid_hours": 72
  }
}