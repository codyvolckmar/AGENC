{
  "listen_host": "0.0.0.0",
  "listen_port": 8080,

  "website_dir": "../website",
  "data_dir": "./data",

  "dry_run": false,

  "site_secret": "REPLACE_WITH_GENERATED_VALUE",
  "admin_key": "REPLACE_WITH_ADMIN_KEY",
  "rate_limit": { "per_ip_per_hour": 10 },

  "request": {
    "max_stack_groups": 6
  },

  "proxmox": {
    "host": "https://127.0.0.1:8006",
    "verify_tls": false,
    "api_token_id": "agenc-bot@pve!agenc",
    "api_token_secret": "REPLACE_FROM_/root/.agenc-token",
    "node": "pve",
    "template_storage": "local",
    "rootfs_storage": "ssd120",
    "os_template": "ubuntu-24.04"
  },

  "container": {
    "vmid_start": 1000,
    "vmid_end": 1999,
    "swap_mb": 512,
    "cpulimit": null,
    "unprivileged": true,
    "net_bridge": "sandbox",
    "net_preflight": true,
    "disk_preflight": true,
    "disk_headroom_pct": 10,
    "ip": "dhcp",
    "features": "nesting=1",
    "ostype": "ubuntu",
    "start": true,
    "agency_ssh_key": "",
    "ssh_port": 22,
    "poll_interval_s": 5,
    "create_timeout_s": 600,
    "stack_timeout_s": 900
  },

  "plans": {
    "micro":    { "memory_mb": 512,  "disk_gb": 4,  "cores": 1, "cpuunits": 256,  "price_usd_per_hour": 0.05 },
    "nano":     { "memory_mb": 1024, "disk_gb": 6,  "cores": 2, "cpuunits": 512,  "price_usd_per_hour": 0.10 },
    "standard": { "memory_mb": 2048, "disk_gb": 8,  "cores": 0, "cpuunits": 1024, "price_usd_per_hour": 0.30 }
  },

  "billing": {
    "free_tier_containers": 1,
    "metered": true,
    "free_credit_usd": 2.0,
    "low_balance_warn_usd": 0.25,
    "deposit_hours": 24,
    "tick_interval_s": 60,
    "max_backfill_s": 86400,
    "default_plan": "standard",
    "accepted_assets": ["USDC", "USDT"],
    "chains": {
      "USDC": { "chain": "ethereum", "network": "ERC-20" },
      "USDT": { "chain": "ethereum", "network": "ERC-20" }
    },
    "receive_addresses": {
      "USDC": "0x0000000000000000000000000000000000000000",
      "USDT": "0x0000000000000000000000000000000000000000"
    },
    "quote_valid_hours": 72
  }
}